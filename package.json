{
  "name": "algo-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive ML algorithm visualizer — edit real Python, watch algorithms train step by step.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/generate-og-images.mjs && node scripts/prerender.mjs",
    "preview": "vite preview",
    "prerender": "node scripts/prerender.mjs",
    "og:images": "node scripts/generate-og-images.mjs",
    "size:check": "node scripts/check-bundle-size.mjs",
    "lhci": "lhci autorun",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "clsx": "^2.1.1",
    "comlink": "^4.4.1",
    "d3": "^7.9.0",
    "katex": "^0.18.4",
    "pyodide": "^0.26.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-katex": "^3.0.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@fontsource/inter": "^5.2.8",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.45.3",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^14.3.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-katex": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.39",
    "satori": "^0.26.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^1.6.0"
  }
}
